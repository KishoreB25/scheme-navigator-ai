# HuggingFace
HF_TOKEN=

# LLM Configuration
GROQ_API_KEY=

# Optional API keys
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=policygpt_bharat

# API Configuration
DEBUG=true
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=bharat_policies

# Firebase Credentials (JSON format - all in one line)
# Download from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste entire JSON here
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key":"YOUR_PRIVATE_KEY",...}